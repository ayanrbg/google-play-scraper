# Domain pointed at this server (A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=playtrend.example.com
PLAYTREND_PUBLIC_URL=https://playtrend.example.com
PLAYTREND_COOKIE_SECURE=true
# No domain yet? Serve plain HTTP on the server IP:
#   DOMAIN=:80
#   PLAYTREND_PUBLIC_URL=http://<server-ip>
#   PLAYTREND_COOKIE_SECURE=false

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Generate: openssl rand -hex 32
PLAYTREND_SECRET_KEY=change-me

# First admin account, created on the first start
PLAYTREND_ADMIN_EMAIL=you@example.com
PLAYTREND_ADMIN_PASSWORD=change-me-too

# The site itself is open to everyone without an account (read-only). Accounts are for the team:
# marks, notes, saved filters, admin tools.
# invite = accounts only via invite links; open = anyone can create an account
PLAYTREND_REGISTRATION=invite
# Plan for workspaces created by public sign-up: free | pro | team
PLAYTREND_DEFAULT_PLAN=team
# Keys reports guests may order per day, all together (each is ~500 proxy requests).
# One IP may also order at most 5 an hour and 12 a day. Signed-in users are not limited.
PLAYTREND_GUEST_KEYS_PER_DAY=40

# Daily pipeline start hour, UTC
PLAYTREND_DAILY_HOUR_UTC=3
# Pace towards Google Play. 2 req/s is safe from one IP; raise carefully.
PLAYTREND_REQUESTS_PER_SECOND=2
# Without proxies 4 is enough. With proxies use about one worker per proxy (20 proxies -> 20):
# a proxied request takes 1-3 s, so fewer workers leave most of the pool idle.
PLAYTREND_WORKERS=4
# Optional proxies for light requests (app pages, suggest), comma separated:
#   http://user:pass@host:port  or  host:port:user:pass (Webshare format), e.g. for a pool of 20:
#   PLAYTREND_PROXIES=1.2.3.4:5678:user:pass,5.6.7.8:9012:user:pass,...
# 20 proxies x 0.7 req/s = ~14 req/s on top of the server's 2. An app page is ~220 KB on the wire
# (gzip), so 10k pages/day is ~65 GB/month of proxy traffic - check your plan's limit.
# Charts always go from the server IP (~1.2 MB each); PLAYTREND_PROXY_HEAVY=true sends them via proxies too.
PLAYTREND_PROXIES=
PLAYTREND_PROXY_RPS=0.7
