# Domain pointed at this server (A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=radar.example.com
GPI_PUBLIC_URL=https://radar.example.com
GPI_COOKIE_SECURE=true
# No domain yet? Serve plain HTTP on the server IP:
#   DOMAIN=:80
#   GPI_PUBLIC_URL=http://<server-ip>
#   GPI_COOKIE_SECURE=false

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Generate: openssl rand -hex 32
GPI_SECRET_KEY=change-me

# First admin account, created on the first start
GPI_ADMIN_EMAIL=you@example.com
GPI_ADMIN_PASSWORD=change-me-too

# invite = team only (via invite links); open = public sign-up (SaaS mode)
GPI_REGISTRATION=invite
# Plan for workspaces created by public sign-up: free | pro | team
GPI_DEFAULT_PLAN=team

# Daily pipeline start hour, UTC
GPI_DAILY_HOUR_UTC=3
# Pace towards Google Play. 2 req/s is safe from one IP; raise carefully.
GPI_REQUESTS_PER_SECOND=2
GPI_WORKERS=4
# Optional proxies for light requests (app pages, suggest), comma separated:
#   http://user:pass@host:port  or  host:port:user:pass (Webshare format)
# Charts always go from the server IP. With proxies raise GPI_WORKERS to ~12.
GPI_PROXIES=
GPI_PROXY_RPS=0.7
